{
	"name": "scouting-mcp",
	"version": "0.1.2",
	"type": "module",
	"description": "MCP server for Scouting America APIs",
	"keywords": [
		"scouting",
		"scouting america",
		"api",
		"mcp"
	],
	"homepage": "https://github.com/scouting-commons/scouting-api/tree/main/packages/mcp#readme",
	"bugs": {
		"url": "https://github.com/scouting-commons/scouting-api/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/scouting-commons/scouting-api.git",
		"directory": "packages/mcp"
	},
	"license": "MIT",
	"bin": {
		"scouting-mcp": "./dist/stdio.mjs"
	},
	"files": [
		"dist",
		"scouting-mcp.mcpb"
	],
	"scripts": {
		"build:client": "pnpm --filter scouting-api build",
		"generate": "openapi-ts",
		"dev": "pnpm build:client && openapi-ts && mcp-inspector node src/stdio.ts",
		"typecheck": "pnpm build:client && openapi-ts && tsc",
		"build": "pnpm build:client && openapi-ts && tsdown",
		"prepack": "pnpm build:mcpb",
		"build:mcpb": "pnpm build && mcpb pack mcpb scouting-mcp.mcpb"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "^2.4.0",
		"scouting-api": "workspace:^",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@anthropic-ai/mcpb": "^2.1.2",
		"@hey-api/openapi-ts": "0.99.0",
		"@modelcontextprotocol/inspector": "^2.13.0",
		"@scouting-commons/scouting-api-spec": "workspace:*",
		"@types/node": "^24.19.0",
		"tsdown": "^0.23.0",
		"typescript": "^6.0.3"
	}
}
