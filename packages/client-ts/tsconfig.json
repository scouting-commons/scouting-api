{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// Runs in browsers as well as Node, so use web APIs and no Node globals
		"lib": ["esnext", "dom", "dom.iterable"],
		"types": [],
		"noEmit": true,
		// tsdown builds into dist. Setting this lets knip map the dist files
		// in package.json exports back to src, instead of reading old builds
		"outDir": "dist",
		// @hey-api/openapi-ts ships declaration files that don't type-check
		// on their own (missing @types/semver, DOM globals, a broken `log` type)
		"skipLibCheck": true,
		// The client runtime that @hey-api/openapi-ts generates passes
		// `undefined` to optional properties
		"exactOptionalPropertyTypes": false
	},
	"include": ["src", "openapi-ts.config.ts", "tsdown.config.ts"]
}
